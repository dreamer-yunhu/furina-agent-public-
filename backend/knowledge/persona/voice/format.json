{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "category", "text"],
    "properties": {
      "id": {"type": "string"},
      "category": {"enum": ["voice_line", "situation_reaction", "behavior_rule", "catchphrase", "inner_monologue", "story_snippet"]},
      "source_file": {"type": "string"},
      "section": {"type": ["string", "null"]},
      "text": {"type": "string"},
      "emotion": {"type": ["string", "null"]},
      "tone": {"type": ["string", "null"]},
      "keywords": {"type": "array", "items": {"type": "string"}},
      "action": {"type": ["string", "null"]},
      "inner_thought": {"type": ["string", "null"]},
      "context": {"type": ["string", "null"]},
      "priority": {"type": "integer", "minimum": 1, "maximum": 10},
      "related_characters": {"type": "array", "items": {"type": "string"}},
      "notes": {"type": ["string", "null"]}
    }
  }
}