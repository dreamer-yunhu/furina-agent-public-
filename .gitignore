# 虚拟环境（.venv* 带通配，覆盖 .venv-build 这类临时环境）
venv-furina/
venv/
ven/
.venv/
.venv*/
# 密钥与配置
.env
*.key
*.pem
# 向量数据库（运行时生成）
chroma_db/
# 角色知识语料（版权内容，不随仓库跟踪/发布；磁盘文件保留）
# ⚠️ 裸 knowledge/ 是兜底：重构后路径会变（apps/desktop/knowledge 等），
#    只写 backend/knowledge/ 会在搬目录后失效，导致版权语料被误提交
knowledge/
backend/knowledge/
# 临时文件与输出
temp_images/
output/
logs/
*.log
# 运行时数据目录 —— SQLite checkpoint 数据库落在这里
# （desktop 入口的 default_db_path() 是 `data/checkpoints.sqlite`）
data/
# 临时诊断产物（我 inspect wheel 源码时留下的目录）
.wheel-inspect/
# 冒烟测试的临时数据库目录（smoke_checkpoint / smoke_task_models 会写这里）
_smoke_tmp/
# Python 编译缓存
__pycache__/
*.pyc
*.pyo
# IDE 配置
.idea/
.vscode/
# 前端脚手架与构建产物（体积巨大，绝不入库）
frontend/node_modules/
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/dist/
node_modules/
# ── 实际的前端位置（2026-10-27 起）：apps/desktop/src/frontend ──
# 上面的 frontend/... 是按仓库根锚定的，覆盖不到这个路径，必须写全
apps/desktop/src/frontend/dist/
apps/desktop/src/frontend/src-tauri/target/
apps/desktop/src/frontend/src-tauri/gen/
# uv 本地缓存（工作区内，避免写用户目录被沙箱拒绝）
.uv-cache/
# 临时探针与个人数据（不进产品仓库）
snapshot.txt
*_probe_*.py
*.xlsx
# ── AI 改动：运行时沙箱与临时产物 ──
# sandbox/ 是 .env 里 SANDBOX_ROOT 指向的**运行时目录**（2026-10-24 起启动时自动创建）
sandbox/
# uv.lock 的升级前备份（回滚用，确认稳定后可删）
uv.lock.bak-*
# 每日改动的临时复核文件（给人看的，不是产品文档）
docs/review/

# 注意：backend/_t_review.py / _exp_a6.py / _demo_prompt.py 这类开发脚手架未被忽略，
#       提交前必须显式排除，别用 git add -A
# 该文件作用：告诉 Git 忽略虚拟环境、密钥、数据库缓存等不应提交的目录和文件

# ── T4 后端打包产物（体积大，不入库）──
dist-backend/
build-backend/
